# ========================================================
# HomeLens Backend - Multi-stage Production Dockerfile
# ========================================================

# Stage 1: Build JAR with Maven & Eclipse Temurin JDK 17
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace

# Cache Maven dependencies
COPY backend/pom.xml ./backend/pom.xml
RUN mvn -f backend/pom.xml dependency:go-offline -B

# Copy backend source code and package application
COPY backend/src ./backend/src
RUN mvn -f backend/pom.xml clean package -DskipTests -B

# Stage 2: Minimal JRE Runtime
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Create directory for persistent local media uploads
RUN mkdir -p /app/uploads/properties

# Copy compiled JAR from build stage
COPY --from=build /workspace/backend/target/*.jar /app/app.jar

# Environment defaults
ENV SERVER_PORT=8080 \
    SPRING_PROFILES_ACTIVE=prod \
    DB_URL=jdbc:postgresql://postgres:5432/homelens \
    DB_USERNAME=homelens \
    DB_PASSWORD=homelens

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
